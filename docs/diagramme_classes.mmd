            +is_published : Booleen
            +quiz_type : Texte
            +ordre : Entier+
        }
        class QuestionQuiz {
            <<table lms_quizquestion>>
            +id : Entier
            +quiz : FK<Quiz>
            +texte : TexteLong
            +points : Entier+
        }
        class ChoixQuiz {
            <<table lms_quizchoice>>
            +id : Entier
            +question : FK<QuestionQuiz>
            +texte : Texte
