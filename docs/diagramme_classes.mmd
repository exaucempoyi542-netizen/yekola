classDiagram
    direction TB

    namespace "Referentiel national et territorial" {
        class Province {
            <<table lms_province>>
            +id : Entier
            +code : Texte
            +cree_le : DateHeure
        }
        class FaculteNationale {
            <<table lms_nationalfaculty>>
            +id : Entier
            +code : Texte
            +nom : Texte
            +est_actif : Booleen
            +cree_le : DateHeure
        }
        class CoursNational {
            <<table lms_nationalcourse>>
            +id : Entier
            +faculte_nationale : FK<FaculteNationale>
            +code : Texte
            +titre : Texte
            +description : TexteLong
            +credits : Entier+
            +semestre : Entier
            +est_actif : Booleen
            +cree_le : DateHeure
        }
        class Universite {
            <<table lms_university>>
            +id : Entier
            +nom : Texte
            +province : FK<Province>
            +enseignant : FK<Utilisateur>
            +type_etablissement : Texte
            +adresse : Texte
            +telephone : Texte
            +email : Texte
            +capacite : Entier+
            +saisie_notes_verrouillee : Booleen
            +semestre1_cloture : Booleen
            +semestre2_cloture : Booleen
            +cree_le : DateHeure
        }
        class Faculte {
            <<table lms_faculty>>
            +id : Entier
            +universite : FK<Universite>
            +faculte_nationale : FK<FaculteNationale>
            +nom : Texte
        }
        class Promotion {
            <<table lms_promotion>>
            +id : Entier
            +faculte : FK<Faculte>
            +nom : Texte
        }
        class GroupeClasse {
            <<table lms_classgroup>>
            +id : Entier
            +promotion : FK<Promotion>
            +nom : Texte
        }
    }

    namespace "Acteurs et journalisation" {
        class Utilisateur {
            <<table lms_user>>
            +id : Entier
            +identifiant : Texte
            +prenom : Texte
            +nom : Texte
            +email : Texte
            +est_actif : Booleen
            +role : Texte
            +telephone : Texte
            +matricule : Texte
            +groupe_classe : FK<GroupeClasse>
            +province_assignee : FK<Province>
            +universite_assignee : FK<Universite>
            +faculte_assignee : FK<Faculte>
            +promotion_assignee : FK<Promotion>
            +semestre_assigne : Entier
            +firebase_uid : Texte
            +profil_complete : Booleen
            +sexe : Texte
        }
        class JournalAudit {
            <<table lms_auditlog>>
            +id : Entier
            +utilisateur : FK<Utilisateur>
            +action : Texte
            +details : TexteLong
            +adresse_ip : GenericIPAddressField
            +horodatage : DateHeure
        }
        class Notification {
            <<table lms_notification>>
            +id : Entier
            +titre : Texte
            +message : TexteLong
            +type : Texte
            +utilisateur : FK<Utilisateur>
            +cree_le : DateHeure
        }
    }

    namespace "Pedagogie et enseignement" {
        class Cours {
            <<table lms_course>>
            +id : Entier
            +titre : Texte
            +cours_national : FK<CoursNational>
            +prerequisite_quiz : FK<Quiz>
            +universite : FK<Universite>
            +faculte : FK<Faculte>
            +promotion : FK<Promotion>
            +description : TexteLong
            +credits : Entier+
            +enseignant : FK<Utilisateur>
            +assigned_to_dean : FK<Utilisateur>
            +created_by : FK<Utilisateur>
            +semestre : Entier
            +cree_le : DateHeure
            +is_published : Booleen
            +price : Decimal
            +is_free : Booleen
            +thumbnail : Fichier
        }
        class Lecon {
            <<table lms_lesson>>
            +id : Entier
            +cours : FK<Cours>
            +titre : Texte
            +content_type : Texte
            +content_file : Fichier
            +content_text : TexteLong
            +ordre : Entier+
        }
        class Inscription {
            <<table lms_enrollment>>
            +id : Entier
            +etudiant : FK<Utilisateur>
            +cours : FK<Cours>
            +enrolled_at : DateHeure
            +progress : Decimal
        }
        class Evaluation {
            <<table lms_evaluation>>
            +id : Entier
            +lecon : FK<Lecon>
            +question : TexteLong
            +option_a : Texte
            +option_b : Texte
            +option_c : Texte
            +option_d : Texte
            +correct_option : Texte
        }
        class NoteEvaluation {
            <<table lms_grade>>
            +id : Entier
            +etudiant : FK<Utilisateur>
            +lecon : FK<Lecon>
            +score : Decimal
            +termine_le : DateHeure
        }
        class TravailPratique {
            <<table lms_assignment>>
            +id : Entier
            +cours : FK<Cours>
            +enseignant : FK<Utilisateur>
            +titre : Texte
            +description : TexteLong
            +date_limite : DateHeure
            +cree_le : DateHeure
        }
        class SoumissionTP {
            <<table lms_assignmentsubmission>>
            +id : Entier
            +travail : FK<TravailPratique>
            +etudiant : FK<Utilisateur>
            +fichier : Fichier
            +soumis_le : DateHeure
            +grade : Decimal
            +grade_comment : TexteLong
            +graded_at : DateHeure
            +is_graded : Booleen
        }
        class RessourceExterne {
            <<table lms_externalresource>>
            +id : Entier
            +titre : Texte
            +description : TexteLong
            +url : Texte
            +thumbnail_url : Texte
            +thumbnail : Fichier
            +categorie : Texte
            +cree_le : DateHeure
        }
        class SessionLive {
            <<table lms_livesession>>
            +id : Entier
            +cours : FK<Cours>
            +enseignant : FK<Utilisateur>
            +room_name : Texte
            +est_actif : Booleen
            +commence_le : DateHeure
            +ended_at : DateHeure
        }
    }

    namespace "Cotation LMD" {
        class CotationEtudiant {
            <<table lms_studentaudit>>
